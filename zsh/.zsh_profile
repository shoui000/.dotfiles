export XDG_CONFIG_HOME=$HOME/.config

export PROJETOS=$HOME/Projetos
export DOTFILES=$HOME/.dotfiles
export EDITOR=nvim
export VISUAL=nvim

# ALIASES
alias cls=clear
alias vim=nvim

hh() {
    cd ~
    clear
}

dot() {
    cd $DOTFILES
		nvim .
}

# PATH
path+=("$HOME/go/bin/")
path+=("$HOME/.cargo/bin")
export PATH

