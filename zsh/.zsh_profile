export XDG_CONFIG_HOME=$HOME/.config

export PROJETOS=$HOME/Projetos
export DOTFILES=$HOME/.dotfiles
export ANOTACOES=$PROJETOS/treeshitter
export EDITOR=nvim
export VISUAL=nvim

alias cls=clear
alias vim=nvim
alias gs="git status"

hh() {
    cd ~
    clear
}

dot() {
    cd $DOTFILES
		nvim .
}

nota() {
	nvim -c "Nota"
}

# PATH
path+=("$HOME/go/bin/")
path+=("$HOME/.cargo/bin")
path+=("$HOME/.local/bin/")
path=("$HOME/.local/share/mise/shims" $path)
export PATH

